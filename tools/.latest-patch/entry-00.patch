+async function saveStoreMasterAligned(req, env, user) {
+  const b = await body(req, 10 * 1024 * 1024);
+  const rows = Array.isArray(b.records) ? b.records : [];
+  if (rows.length > 1000) return json({ status:'error', message:'อัปโหลด Master Store ครั้งละไม่เกิน 1,000 สาขา' }, 413);
+  const t = now();
+  let count = 0;
+  for (let i = 0; i < rows.length; i += 40) {
+    const statements = [], codes = [];
+    for (const raw of rows.slice(i, i + 40)) {
+      const x = storeMasterImportView(raw);
+      if (!x.storeCode) continue;
+      statements.push(env.DB.prepare(`
+        INSERT INTO master_stores(store_code,store_name,format_type,store_type,check_100,raw_json,updated_at)
+        VALUES(?,?,?,?,?,?,?)
+        ON CONFLICT(store_code) DO UPDATE SET
+          store_name=excluded.store_name,format_type=excluded.format_type,store_type=excluded.store_type,
+          check_100=excluded.check_100,raw_json=excluded.raw_json,updated_at=excluded.updated_at
+      `).bind(x.storeCode,x.storeName,x.formatType,x.storeType,x.check100,JSON.stringify(raw),t));
+      codes.push(x.storeCode); count++;
+    }
+    if (statements.length) await env.DB.batch(statements);
+    if (codes.length) {
+      await env.DB.prepare(`
+        UPDATE master_stores SET check_100=COALESCE(
+          (SELECT flag FROM master_check100 c WHERE c.store_code=master_stores.store_code),check_100,''
+        ) WHERE store_code IN (${marks(codes.length)})
+      `).bind(...codes).run();
+    }
+  }
+  await audit(env,user.username,'UPLOAD_MASTER_STORE_ALIGNED','MasterStore','','','',`rows=${count}`);
+  return json({ status:'success', count, message:'อัปเดต Master Store แล้ว' });
 }
 
